LOCAL_DB=true
MONGODB_URI=mongodb://127.0.0.1:27017
PREDICT_SERVER_URL=http://127.0.0.1:8000
# 旧单地址配置：未被 RANKING_SOURCES 覆盖的内置列表继续使用
RANKING_API_BASE_URL=https://grp-speed-backend.starfreedomx.top
# 按服务器配置任意数量的排名数据源，依次尝试；地址填写到 /api 之前
# 可用键：jp / en / tw / cn / kr / global（月榜元数据）/ default（其他查询）
# 未列出的服务器保留内置配置；设置 default 可统一覆盖，[] 可禁用对应列表
# RANKING_SOURCES='{"cn":["https://cn-a.example.com","https://cn-b.example.com"],"jp":["https://jp.example.com"],"global":["https://cn-a.example.com"]}'
MONGODB_DATABASE_NAME=tsugu-bangdream-bot
ARTICLE=true
MEMORY_CACHE=true
MEMORY_MONITOR=true
# 内存监控采样周期，最低 5000ms
MEMORY_MONITOR_INTERVAL_MS=60000
# 默认不记录完整请求体，避免大对象日志产生额外内存峰值
DEBUG_REQUEST_BODY=false
USE_BANDORISTATION=true
BACKEND_PORT=3000
BANGDREAM_OPTIMIZE_BASE_URL=http://127.0.0.1:3100
# 直接配置完整远程计算接口也可以：
# BANGDREAM_OPTIMIZE_CALC_URL=http://127.0.0.1:3100/v1/calc-result
